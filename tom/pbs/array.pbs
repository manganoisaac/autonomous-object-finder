#!/bin/bash
# Queue test: many small subjobs -> how many run concurrently per user.
#PBS -N wbmc_arr
#PBS -q workq
#PBS -J 1-100
#PBS -l select=1:ncpus=1:mem=1gb
#PBS -l walltime=00:20:00
#PBS -j oe
#PBS -o /scratch/s5453352/webots_mc/arr_logs/
cd /scratch/s5453352/webots_mc
OUT=results/arr; mkdir -p $OUT
echo "idx=$PBS_ARRAY_INDEX host=$(hostname) start=$(date +%s)"
apptainer exec --cleanenv --no-home --writable-tmpfs --bind proj:/proj,$OUT:/results webots-mc.sif \
  bash /scratch/s5453352/webots_mc/hpc_run.sh 1 60 bench_A /results a${PBS_ARRAY_INDEX}
echo "end=$(date +%s)"
